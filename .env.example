# Copy to .env for local development. On Vercel, set these as Environment Variables
# instead — the app reads process.env first and only falls back to this file.

# Required. Lyzr Agent Studio API key; every agent call uses it.
LYZR_API_KEY=

# Optional but strongly recommended. Apollo enrichment: the company record, the partner's
# logo for the brief, and the only thing that works when a site sits behind a WAF.
# Without it the agent still runs, from the crawl alone.
APOLLO_API_KEY=
